# Copy this file to .env.local and fill in the values you have.
# The site works with none of these set — preorders just get logged to the
# server console and saved to ./data/preorders.jsonl instead of emailed.

# Resend (https://resend.com) — used to email you + the customer when a
# preorder comes in. Free tier is enough to start.
RESEND_API_KEY=

# Where preorder notifications should be sent.
OWNER_EMAIL=you@example.com

# Must be a domain you've verified with Resend once you're ready to send
# real email. Until then you can leave this unset in development.
FROM_EMAIL=orders@yourdomain.com
